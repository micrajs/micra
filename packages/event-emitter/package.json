{
  "name": "@micra/event-emitter",
  "description": "Micra's official Event Emitter API implementation",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Olavo Amorim Santos<olavo.santos@micra.dev>",
  "repository": {
    "type": "git",
    "url": "https://github.com/micrajs/micra.git",
    "directory": "packages/event-emitter"
  },
  "bugs": {
    "url": "https://github.com/micrajs/micra/issues?q=is:issue+is:open+label:%22Project:+event-emitter%22+label:%22Type:+fix%22"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "type": "module",
  "files": ["dist"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./EventEmitter": {
      "types": "./dist/EventEmitter.d.ts",
      "import": "./dist/EventEmitter.js",
      "require": "./dist/EventEmitter.cjs"
    },
    "./Event": {
      "types": "./dist/Event.d.ts",
      "import": "./dist/Event.js",
      "require": "./dist/Event.cjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "check": "pnpm build -l error && run-p check:*",
    "check:size": "size-limit --silent",
    "check:types": "tsc --noEmit",
    "clean": "rm -rf .turbo && rm -rf node_modules && rm -rf dist",
    "dev": "vite build --watch",
    "docs:generate": "typedoc --options .typedoc.mjs",
    "generate": "turbo gen",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test": "vitest run"
  },
  "dependencies": {
    "@micra/error": "workspace:^0.0.0"
  },
  "devDependencies": {
    "@micra/core": "workspace:^0.0.0",
    "@size-limit/preset-small-lib": "^11.2.0",
    "@types/benchmark": "^2.1.5",
    "@vitest/coverage-v8": "^3.1.1",
    "benchmark": "^2.1.4",
    "npm-run-all": "^4.1.5",
    "size-limit": "^11.2.0",
    "vite": "^6.3.4",
    "vite-plugin-dts": "^4.5.3",
    "vitest": "^3.1.1"
  }
}
